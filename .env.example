# Copy this file to `.env.local` and fill in your Supabase credentials.
# These are required — Taalib needs an account (Supabase Postgres as the
# source of truth) to run at all. Without them the app shows a
# "not configured" screen instead of starting.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Dev-only, used by scripts/dev-magic-link.mjs. Never prefix with VITE_ (that
# would bundle it into client-side JS) and never commit a real value — this
# key has full admin access and bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...